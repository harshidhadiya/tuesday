{
	"info": {
		"_postman_id": "auction-complete-lifecycle-2026",
		"name": "MACUTION - Complete Microservice Lifecycle",
		"description": "Complete flow for all microservices:\n1. Seller: Signup -> Product Management\n2. Admin: Signup -> Verification Flow\n3. Approval: Admin verifies Product\n4. Auction: Seller creates Auction\n5. Bidder: Signup -> Watch -> Place Bid",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "👤 1. Seller Flow",
			"item": [
				{
					"name": "1.1 Seller Signup",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "Name", "value": "{{sellerName}}", "type": "text" },
								{ "key": "Email", "value": "{{sellerEmail}}", "type": "text" },
								{ "key": "Password", "value": "{{sellerPassword}}", "type": "text" },
								{ "key": "Phone", "value": "9876543210", "type": "text" },
								{ "key": "Address", "value": "Seller HQ", "type": "text" },
								{ "key": "Role", "value": "SELLER", "type": "text" }
							]
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/user/create",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "user", "create"]
						}
					},
					"response": []
				},
				{
					"name": "1.2 Seller Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.success && json.data) {",
									"    if (json.data.token) pm.collectionVariables.set('sellerToken', json.data.token);",
									"    if (json.data.userId) pm.collectionVariables.set('sellerId', json.data.userId.toString());",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{sellerEmail}}\",\n    \"password\": \"{{sellerPassword}}\",\n    \"role\": \"SELLER\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/user/login",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "user", "login"]
						}
					},
					"response": []
				},
				{
					"name": "1.3 Add Product",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.success && json.data) {",
									"    pm.collectionVariables.set('productId', json.data.id.toString());",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{sellerToken}}", "type": "string" }]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"{{productName}}\",\n    \"description\": \"Luxury vintage item.\",\n    \"date\": \"2024-06-15T10:00:00Z\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/product",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "product"]
						}
					},
					"response": []
				},
				{
					"name": "1.4 Update Product (Full Detail)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{sellerToken}}", "type": "string" }]
						},
						"method": "PATCH",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "name", "value": "Refined {{productName}}", "type": "text" },
								{ "key": "description", "value": "Updated with detailed assessment.", "type": "text" }
							]
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/product/{{productId}}",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "product", "{{productId}}"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "🛡️ 2. Admin Onboarding Flow",
			"item": [
				{
					"name": "2.1 New Admin Signup",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"{{adminName}}\",\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\",\n    \"phone\": \"9998887776\",\n    \"address\": \"Admin Center\",\n    \"role\": \"ADMIN\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/admin/signup",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "admin", "signup"]
						}
					},
					"response": []
				},
				{
					"name": "2.2 Master Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.success && json.data) {",
									"    pm.collectionVariables.set('masterAdminToken', json.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{masterAdminEmail}}\",\n    \"password\": \"{{masterAdminPassword}}\",\n    \"role\": \"ADMIN\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/admin/Login",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "admin", "Login"]
						}
					},
					"response": []
				},
				{
					"name": "2.3 Master Verify New Admin",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// This script fetches pending requests first if no requestId is set"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{masterAdminToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gatewayUrl}}/api/admin-request/verify/{{requestId}}",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "admin-request", "verify", "{{requestId}}"]
						}
					},
					"response": []
				},
				{
					"name": "2.4 Fetch RequestId (Admin Help)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"const target = pm.collectionVariables.get('adminEmail');",
									"const req = json.data.find(r => r.email === target);",
									"if (req) pm.collectionVariables.set('requestId', req.requestUserId.toString());"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{masterAdminToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gatewayUrl}}/api/admin-request/pending",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "admin-request", "pending"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "✅ 3. Product Approval Flow",
			"item": [
				{
					"name": "3.1 Verify Product",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"productId\": {{productId}},\n    \"description\": \"Approving for auction.\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/admin-product/verify",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "admin-product", "verify"]
						}
					},
					"response": []
				},
				{
					"name": "3.2 Check Verification Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gatewayUrl}}/api/verify/status/{{productId}}",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "verify", "status", "{{productId}}"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "🔨 4. Auction Lifecycle",
			"item": [
				{
					"name": "4.1 Seller: Create Auction",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const now = new Date();",
									"const start = new Date(now.getTime() + 60 * 1000); // 1 min from now",
									"const end = new Date(now.getTime() + 24 * 60 * 60 * 1000); // 24 hours",
									"pm.collectionVariables.set('auctionStart', start.toISOString());",
									"pm.collectionVariables.set('auctionEnd', end.toISOString());"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.success && json.data) {",
									"    pm.collectionVariables.set('auctionId', json.data.id.toString());",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{sellerToken}}", "type": "string" }]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"productId\": {{productId}},\n    \"startingPrice\": 100.00,\n    \"reservePrice\": 500.00,\n    \"minBidIncrement\": 10.00,\n    \"startDate\": \"{{auctionStart}}\",\n    \"endDate\": \"{{auctionEnd}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{auctionUrl}}/api/auctions",
							"host": ["{{auctionUrl}}"],
							"path": ["api", "auctions"]
						}
					},
					"response": []
				},
				{
					"name": "4.2 List Live Auctions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{auctionUrl}}/api/auctions?Status=Live",
							"host": ["{{auctionUrl}}"],
							"path": ["api", "auctions"],
							"query": [{ "key": "Status", "value": "Live" }]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "💰 5. Bidder Flow",
			"item": [
				{
					"name": "5.1 Bidder Signup",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "Name", "value": "{{bidderName}}", "type": "text" },
								{ "key": "Email", "value": "{{bidderEmail}}", "type": "text" },
								{ "key": "Password", "value": "{{bidderPassword}}", "type": "text" },
								{ "key": "Role", "value": "USER", "type": "text" }
							]
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/user/create",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "user", "create"]
						}
					},
					"response": []
				},
				{
					"name": "5.2 Bidder Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.success && json.data) {",
									"    pm.collectionVariables.set('bidderToken', json.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{bidderEmail}}\",\n    \"password\": \"{{bidderPassword}}\",\n    \"role\": \"USER\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/user/login",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "user", "login"]
						}
					},
					"response": []
				},
				{
					"name": "5.3 Place Bid",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{bidderToken}}", "type": "string" }]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"amount\": 150.00\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{auctionUrl}}/api/auctions/{{auctionId}}/bids",
							"host": ["{{auctionUrl}}"],
							"path": ["api", "auctions", "{{auctionId}}", "bids"]
						}
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": ["pm.test('Healthy Status', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"]
			}
		}
	],
	"variable": [
		{ "key": "gatewayUrl", "value": "http://localhost:5000", "type": "string" },
		{ "key": "auctionUrl", "value": "http://localhost:5001", "type": "string" },
		{ "key": "sellerName", "value": "Seller_{{$randomInt}}", "type": "string" },
		{ "key": "sellerEmail", "value": "seller{{$randomInt}}@test.com", "type": "string" },
		{ "key": "sellerPassword", "value": "Seller@123", "type": "string" },
		{ "key": "bidderName", "value": "Bidder_{{$randomInt}}", "type": "string" },
		{ "key": "bidderEmail", "value": "bidder{{$randomInt}}@test.com", "type": "string" },
		{ "key": "bidderPassword", "value": "Bidder@123", "type": "string" },
		{ "key": "adminName", "value": "Admin_{{$randomInt}}", "type": "string" },
		{ "key": "adminEmail", "value": "admin{{$randomInt}}@test.com", "type": "string" },
		{ "key": "adminPassword", "value": "Admin@123", "type": "string" },
		{ "key": "masterAdminEmail", "value": "admin@test.com", "type": "string" },
		{ "key": "masterAdminPassword", "value": "123456", "type": "string" },
		{ "key": "productName", "value": "Vintage Omega Watch", "type": "string" },
		{ "key": "sellerToken", "value": "", "type": "string" },
		{ "key": "sellerId", "value": "", "type": "string" },
		{ "key": "bidderToken", "value": "", "type": "string" },
		{ "key": "adminToken", "value": "", "type": "string" },
		{ "key": "masterAdminToken", "value": "", "type": "string" },
		{ "key": "productId", "value": "", "type": "string" },
		{ "key": "requestId", "value": "", "type": "string" },
		{ "key": "auctionId", "value": "", "type": "string" },
		{ "key": "auctionStart", "value": "", "type": "string" },
		{ "key": "auctionEnd", "value": "", "type": "string" }
	]
}
