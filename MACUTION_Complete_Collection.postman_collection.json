							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
									"",
									"const json = pm.response.json();",
									"if (json.success && json.data) {",
									"    if (json.data.token) pm.collectionVariables.set('sellerToken', json.data.token);",
									"    if (json.data.id) pm.collectionVariables.set('sellerId', json.data.id.toString());",
									"    console.log('Seller logged in, token set, ID:', json.data.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
