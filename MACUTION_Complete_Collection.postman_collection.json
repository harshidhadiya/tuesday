		{
			"name": "📦 4. Product Service",
			"description": "Product microservice endpoints. Products are created by sellers, then verified by admins, then can be scheduled for auction.\n\n**Flow:** Seller creates product → Admin verifies → Seller schedules auction",
			"item": [
				{
					"name": "4.1 Create Product",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
									"",
									"const json = pm.response.json();",
									"if (json.success && json.data) {",
									"    pm.collectionVariables.set('productId', json.data.id.toString());",
									"    pm.collectionVariables.set('productName', json.data.Name || json.data.name || 'Vintage Watch');",
									"    console.log('Product created, ID:', json.data.id);",
									"}"
								]
							}
						}
