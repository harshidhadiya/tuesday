{
	"info": {
		"_postman_id": "macution-complete-flow-2026",
		"name": "MACUTION - Complete API Gateway Collection",
		"description": "Complete Postman collection for the MACUTION microservice platform.\nAll requests go through the API Gateway at localhost:5000.\n\n**Flow Order:**\n1. 🔑 Setup — Generate tokens\n2. 👤 User — Create user, login, profile\n3. 🛡️ Admin Auth — Admin signup, login\n4. 📋 Admin Request — Verify requests, grant/revoke rights\n5. 📦 Product — Create, update, list, delete products\n6. ✅ Admin Product — Verify/unverify products (via RabbitMQ)\n7. 🔍 Verify — Check verification status, list verified/unverified\n\n**Setup:**\n1. Run \"Generate Seller Token\" or \"Generate Admin Token\" first\n2. All subsequent requests auto-use the generated tokens\n3. Variables cascade: responses auto-populate IDs for next requests",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "gatewayUrl", "value": "http://localhost:5000", "type": "string" },
		{ "key": "jwtKey", "value": "harshidHADIYAHOWAREYOUDFSDFSDSDFGS", "type": "string" },
		{ "key": "sellerToken", "value": "", "type": "string" },
		{ "key": "adminToken", "value": "", "type": "string" },
		{ "key": "sellerId", "value": "", "type": "string" },
		{ "key": "adminId", "value": "", "type": "string" },
		{ "key": "requestId", "value": "1", "type": "string" },
