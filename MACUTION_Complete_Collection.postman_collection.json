			"name": "👤 1. User Service",
			"item": [
				{
					"name": "1.1 Create Seller Account",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
									"",
									"const json = pm.response.json();",
									"if (json.success && json.data) {",
									"    if (json.data.id) pm.collectionVariables.set('sellerId', json.data.id.toString());",
									"    console.log('Seller created, ID:', json.data.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"{{sellerName}}\",\n    \"password\": \"{{sellerPassword}}\",\n    \"email\": \"{{sellerEmail}}\",\n    \"phone\": \"9876543210\",\n    \"address\": \"123 Market Street, Mumbai\",\n    \"role\": \"SELLER\"\n}"
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/user/create",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "user", "create"]
						},
						"description": "Register a new seller account.\n**Auto-sets:** `sellerId`"
					}
				},
				{
