{
	"info": {
		"_postman_id": "macution-ui-flows-2026",
		"name": "MACUTION - UI Page Flow Collection",
		"description": "Comprehensive Postman collection for the MACUTION microservice platform, organized by the UI pages that consume the endpoints.\n\n**Base URL:** `http://localhost:5000` (API Gateway)\n\n**Variables Used:**\n- `baseUrl`: The API Gateway address.\n- `userToken`: Bearer token for user actions.\n- `adminToken`: Bearer token for admin actions.\n- `userId`: Active user ID.\n- `productId`: Active product ID.\n- `auctionId`: Active auction ID.\n- `requestId`: User identity verification request ID.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
		{ "key": "userToken", "value": "", "type": "string" },
		{ "key": "adminToken", "value": "", "type": "string" },
		{ "key": "userId", "value": "", "type": "string" },
		{ "key": "productId", "value": "", "type": "string" },
		{ "key": "auctionId", "value": "", "type": "string" },
		{ "key": "requestId", "value": "", "type": "string" },
		{ "key": "verifierId", "value": "", "type": "string" }
	],
	"item": [
		{
			"name": "🔐 1. Authentication & User Management",
			"item": [
				{
					"name": "1.1 Register User",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "Name", "value": "John Doe", "type": "text" },
								{ "key": "Email", "value": "john@example.com", "type": "text" },
								{ "key": "Password", "value": "Password@123", "type": "text" },
								{ "key": "Phone", "value": "1234567890", "type": "text" },
								{ "key": "Address", "value": "123 Main St", "type": "text" },
								{ "key": "Role", "value": "USER", "type": "text" }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/user/create",
							"host": ["{{baseUrl}}"],
							"path": ["api", "user", "create"]
						},
						"description": "Register a new user account using FormData."
					}
				},
				{
					"name": "1.2 User Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.success && json.data) {",
									"    pm.collectionVariables.set('userToken', json.data.token);",
									"    pm.collectionVariables.set('userId', json.data.id.toString());",
									"    console.log('Login successful, token and userId set.');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"john@example.com\",\n    \"password\": \"Password@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/user/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "user", "login"]
						},
						"description": "Authenticates the user and retrieves a JWT token."
					}
				},
				{
					"name": "1.3 Get Current User Profile",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/user/profile/0",
							"host": ["{{baseUrl}}"],
							"path": ["api", "user", "profile", "0"]
						},
						"description": "Fetches the current logged-in user's profile information."
					}
				},
				{
					"name": "1.4 Update User Profile",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "PATCH",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "Name", "value": "John Updated", "type": "text" },
								{ "key": "Phone", "value": "9998887776", "type": "text" },
								{ "key": "ProfileImage", "type": "file", "src": [] }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/user/profile",
							"host": ["{{baseUrl}}"],
							"path": ["api", "user", "profile"]
						},
						"description": "Updates user profile details via FormData."
					}
				},
				{
					"name": "1.5 Get Admin Profile (from Profile Page)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/admin/profile?userid={{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "profile"],
							"query": [
								{ "key": "userid", "value": "{{userId}}" }
							]
						},
						"description": "Fetches admin-specific profile data if the user is an Admin."
					}
				}
			]
		},
		{
			"name": "📦 2. Product Management",
			"item": [
				{
					"name": "2.1 List Products (Paginated)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"currentPage\": 1,\n    \"pageSize\": 10,\n    \"searchName\": \"\",\n    \"verifiedFilter\": null,\n    \"buyFrom\": 0,\n    \"buyTo\": 5000\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/Product/all",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Product", "all"]
						},
						"description": "Fetches a paginated list of products for the Products Hub."
					}
				},
				{
					"name": "2.2 Create New Product",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.success && json.data) {",
									"    pm.collectionVariables.set('productId', json.data.id.toString());",
									"    console.log('Product created, ID set to:', json.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "Name", "value": "Vintage Camera", "type": "text" },
								{ "key": "Description", "value": "A well-preserved vintage Leica camera from 1950.", "type": "text" },
								{ "key": "Images", "type": "file", "src": [] }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/Product",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Product"]
						},
						"description": "Adds a new product to the platform."
					}
				},
				{
					"name": "2.3 Update Product",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Updated Product Name\",\n    \"description\": \"Updated description text.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/Product/{{productId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Product", "{{productId}}"]
						},
						"description": "Updates an existing product."
					}
				},
				{
					"name": "2.4 Delete Product",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/Product/{{productId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Product", "{{productId}}"]
						},
						"description": "Removes a product from the database."
					}
				},
				{
					"name": "2.5 Add Product Images",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "ProductId", "value": "{{productId}}", "type": "text" },
								{ "key": "Images", "type": "file", "src": [] }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/Product/images",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Product", "images"]
						},
						"description": "Adds new images to an existing product during update."
					}
				},
				{
					"name": "2.6 Delete Specific Product Image",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/Product/{{productId}}/images/{{imageId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Product", "{{productId}}", "images", "{{imageId}}"]
						},
						"description": "Deletes a specific product image."
					}
				}
			]
		},
		{
			"name": "🔨 3. Auction Management",
			"item": [
				{
					"name": "3.1 List All Auctions (Hall)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auctions?Page=1&PageSize=10&Status=Live&MinPrice=0&MaxPrice=10000",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auctions"],
							"query": [
								{ "key": "Page", "value": "1" },
								{ "key": "PageSize", "value": "10" },
								{ "key": "Status", "value": "Live" },
								{ "key": "MinPrice", "value": "0" },
								{ "key": "MaxPrice", "value": "10000" }
							]
						},
						"description": "Fetches a paginated list of all auctions."
					}
				},
				{
					"name": "3.2 Launch/Verify Auction",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"productId\": {{productId}},\n    \"startPrice\": 100,\n    \"reservePrice\": 200,\n    \"startTime\": \"2024-06-01T12:00:00Z\",\n    \"endTime\": \"2024-06-02T12:00:00Z\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/verify/auction",
							"host": ["{{baseUrl}}"],
							"path": ["api", "verify", "auction"]
						},
						"description": "Moves an auction from verification stage to active/scheduled."
					}
				},
				{
					"name": "3.3 Update Auction Parameters",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"startPrice\": 120,\n    \"reservePrice\": 250\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auctions/{{auctionId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auctions", "{{auctionId}}"]
						},
						"description": "Updates auction parameters like prices or dates."
					}
				},
				{
					"name": "3.4 Cancel Auction",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auctions/{{auctionId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auctions", "{{auctionId}}"]
						},
						"description": "Cancels an upcoming or scheduled auction."
					}
				},
				{
					"name": "3.5 My Created Auctions",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auctions/created",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auctions", "created"]
						},
						"description": "Lists all auctions created by the current user."
					}
				},
				{
					"name": "3.6 My Participations",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auctions/participated",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auctions", "participated"]
						},
						"description": "Lists auctions where the user has placed at least one bid."
					}
				}
			]
		},
		{
			"name": "👁️ 4. Watchlist & Social",
			"item": [
				{
					"name": "4.1 Get Watchlist",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/Watchlist/watched",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Watchlist", "watched"]
						},
						"description": "Fetches the list of auctions the user is watching."
					}
				},
				{
					"name": "4.2 Watch Auction",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/Watchlist/{{auctionId}}/watch",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Watchlist", "{{auctionId}}", "watch"]
						},
						"description": "Adds an auction to the user's watchlist."
					}
				},
				{
					"name": "4.3 Unwatch Auction",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/Watchlist/{{auctionId}}/watch",
							"host": ["{{baseUrl}}"],
							"path": ["api", "Watchlist", "{{auctionId}}", "watch"]
						},
						"description": "Removes an auction from the user's watchlist."
					}
				}
			]
		},
		{
			"name": "🛡️ 5. Admin Management",
			"item": [
				{
					"name": "5.1 Admin Identity Verification Dashboard",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.success && json.data && json.data.length > 0) {",
									"    pm.collectionVariables.set('requestId', json.data[0].id.toString());",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
						},
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"\",\n    \"email\": \"\",\n    \"pending\": true,\n    \"page\": 1,\n    \"pageSize\": 10\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin-request/filter",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin-request", "filter"]
						},
						"description": "Lists and filters user identity verification requests."
					}
				},
				{
					"name": "5.2 Get Requester Full Details",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/admin/profile?userid={{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "profile"],
							"query": [
								{ "key": "userid", "value": "{{userId}}" }
							]
						},
						"description": "Fetches detailed profile of the verification requester."
					}
				},
				{
					"name": "5.3 Approve Identity Verification",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/admin-request/verify/{{requestId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin-request", "verify", "{{requestId}}"]
						},
						"description": "Approves the user's identity verification."
					}
				},
				{
					"name": "5.4 Grant Posting Rights",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/admin-request/grant-rights/{{requestId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin-request", "grant-rights", "{{requestId}}"]
						},
						"description": "Grants the user rights to post items (Can Post)."
					}
				},
				{
					"name": "5.5 Revoke Posting Rights",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/admin-request/revoke-rights/{{requestId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin-request", "revoke-rights", "{{requestId}}"]
						},
						"description": "Removes the user's posting rights."
					}
				},
				{
					"name": "5.6 Revoke Identity Verification",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/admin-request/revoke-verification/{{requestId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin-request", "revoke-verification", "{{requestId}}"]
						},
						"description": "Cancels a previously approved verification."
					}
				},
				{
					"name": "5.7 Get Verifier Details",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/admin-request/details/{{verifierId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin-request", "details", "{{verifierId}}"]
						},
						"description": "Shows who performed the verification for a specific user."
					}
				},
				{
					"name": "5.8 Admin Product Verification List",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
						},
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"\",\n    \"pending\": true,\n    \"page\": 1,\n    \"pagesize\": 10\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/verify/products",
							"host": ["{{baseUrl}}"],
							"path": ["api", "verify", "products"]
						},
						"description": "Lists products awaiting or completed verification by admins."
					}
				},
				{
					"name": "5.9 Approve & Verify Product",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
						},
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"ProductId\": {{productId}},\n    \"SellerId\": {{userId}},\n    \"description\": \"Product verified by Admin.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/verify/product",
							"host": ["{{baseUrl}}"],
							"path": ["api", "verify", "product"]
						},
						"description": "Formally verifies a seller's product for the marketplace."
					}
				},
				{
					"name": "5.10 Unverify Product",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
						},
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"ProductId\": {{productId}},\n    \"description\": \"Violation of terms.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/verify/product",
							"host": ["{{baseUrl}}"],
							"path": ["api", "verify", "product"]
						},
						"description": "Revokes verification for a product."
					}
				},
				{
					"name": "5.11 Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.success && json.data) {",
									"    pm.collectionVariables.set('adminToken', json.data.token);",
									"    console.log('Admin login successful.');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"Admin@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/Login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "Login"]
						},
						"description": "Admin-specific authentication."
					}
				},
