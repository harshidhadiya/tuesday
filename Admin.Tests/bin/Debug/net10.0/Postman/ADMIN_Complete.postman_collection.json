{
	"info": {
		"_postman_id": "admin-complete-collection-2026",
		"name": "ADMIN Service - Complete Collection",
		"description": "Complete Postman collection for the ADMIN microservice. Covers all AdminRequest and AdminProduct endpoints with auto-filled data.\n\n**Setup:**\n1. Set the `baseUrl` variable (default: http://localhost:5087)\n2. Set the `jwtKey` variable to your JWT secret key\n3. Run the \"Generate Admin Token\" request first to auto-populate the `adminToken` variable\n4. All subsequent requests will automatically use the generated token",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5087",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "jwtKey",
			"value": "harshidHADIYAHOWAREYOUDFSDFSDSDFGS",
			"type": "string"
		},
		{
			"key": "adminId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "requestId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "productId",
			"value": "1",
			"type": "string"
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// ─── Auto-generate JWT if adminToken is empty ───",
					"if (!pm.collectionVariables.get('adminToken') || pm.collectionVariables.get('adminToken') === '') {",
					"    const header = btoa(JSON.stringify({ alg: 'HS256', typ: 'JWT' })).replace(/=/g, '');",
					"    const adminId = pm.collectionVariables.get('adminId') || '1';",
					"    const now = Math.floor(Date.now() / 1000);",
					"    const payload = btoa(JSON.stringify({",
					"        Name: 'AdminUser',",
					"        'http://schemas.microsoft.com/ws/2008/06/identity/claims/role': 'ADMIN',",
					"        ID: adminId,",
					"        exp: now + 86400,",
					"        iat: now",
					"    })).replace(/=/g, '');",
					"    ",
					"    // NOTE: This creates a pseudo-JWT for Postman testing.",
					"    // For real HMAC-SHA256, use the pre-request script below with CryptoJS.",
					"    const jwtKey = pm.collectionVariables.get('jwtKey');",
					"    const CryptoJS = require('crypto-js');",
					"    const signature = CryptoJS.HmacSHA256(header + '.' + payload, jwtKey);",
					"    const sigBase64 = CryptoJS.enc.Base64.stringify(signature).replace(/=/g, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
					"    const token = header + '.' + payload + '.' + sigBase64;",
					"    pm.collectionVariables.set('adminToken', token);",
					"    console.log('Auto-generated admin JWT token');",
					"}"
				]
			}
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{adminToken}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "🔑 Setup",
			"item": [
				{
					"name": "Generate Admin Token",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Force regenerate token",
									"pm.collectionVariables.set('adminToken', '');",
									"",
									"const adminId = pm.collectionVariables.get('adminId') || '1';",
									"const now = Math.floor(Date.now() / 1000);",
									"",
									"const header = btoa(JSON.stringify({ alg: 'HS256', typ: 'JWT' })).replace(/=/g, '');",
									"const payload = btoa(JSON.stringify({",
									"    Name: 'AdminUser',",
									"    'http://schemas.microsoft.com/ws/2008/06/identity/claims/role': 'ADMIN',",
									"    ID: adminId,",
									"    exp: now + 86400,",
									"    iat: now",
									"})).replace(/=/g, '');",
									"",
									"const jwtKey = pm.collectionVariables.get('jwtKey');",
									"const CryptoJS = require('crypto-js');",
									"const signature = CryptoJS.HmacSHA256(header + '.' + payload, jwtKey);",
									"const sigBase64 = CryptoJS.enc.Base64.stringify(signature).replace(/=/g, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
									"const token = header + '.' + payload + '.' + sigBase64;",
									"pm.collectionVariables.set('adminToken', token);",
									"console.log('Generated admin JWT:', token);"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Health check returns 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Admin token is set', function () {",
									"    const token = pm.collectionVariables.get('adminToken');",
									"    pm.expect(token).to.not.be.empty;",
									"    console.log('Token set successfully:', token.substring(0, 50) + '...');",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/",
							"host": ["{{baseUrl}}"],
							"path": [""]
						},
						"description": "Generates a valid admin JWT token and stores it in the `adminToken` collection variable. Run this FIRST before any other request."
					}
				}
			]
		},
		{
