			"item": [
				{
					"name": "Get Pending Requests",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has correct structure', function () {",
									"    const json = pm.response.json();",
									"    pm.expect(json).to.have.property('success', true);",
									"    pm.expect(json).to.have.property('data');",
									"    pm.expect(json.data).to.be.an('array');",
									"});",
									"",
									"// Auto-set requestId from first pending request",
									"const json = pm.response.json();",
									"if (json.data && json.data.length > 0) {",
									"    pm.collectionVariables.set('requestId', json.data[0].requestUserId.toString());",
									"    console.log('Auto-set requestId to:', json.data[0].requestUserId);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/admin-request/pending",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin-request", "pending"]
						},
